# ============================================================
# 复制本文件为 config.env，按需填写。所有密钥都在本地，不会上传。
# 不填任何 key、保持 DEMO_MODE=true 也能直接看完整交互（演示用规则生成）。
# ============================================================

# 演示模式：true 时解析/转写/分析/对话全部用本地规则生成，无需联网或付费
DEMO_MODE=true

# ---------- 真实模式：把上面一行改成 false，并填下面两项 ----------
# DEMO_MODE=false

# 大模型（OpenAI / DeepSeek / 通义 等，接口互相兼容）
# 方式一（推荐，最省事）：只填服务商 + key，base_url/model 自动配好
# LLM_PROVIDER=deepseek      # 可选 deepseek / qwen(通义千问) / moonshot(Kimi) / doubao(火山方舟) / openai
# LLM_API_KEY=sk-你的key
#   deepseek 默认模型 deepseek-chat；qwen 默认 qwen-plus；moonshot 默认 moonshot-v1-8k
#
#   ★ 火山方舟（豆包）专项说明：
#   LLM_PROVIDER=doubao
#   LLM_API_KEY=ek-你的方舟key        # 方舟控制台「API 密钥管理」创建，ek- 开头
#   LLM_MODEL=ep-2024xxxxxx-xxxxx    # 强烈建议填「推理接入点 ID」
#     - 获取：方舟控制台 → 在线推理 → 创建推理接入点 → 状态「运行中」后复制 ep- 开头的 ID
#     - 直接填模型名（如 doubao-pro-32k）若报 404 / Model not found，就换成 ep- ID
#     - 前置条件：注册火山引擎 → 实名认证 → 模型管理中心开通豆包模型 → 再创建接入点
# 方式二（手动）：显式指定 base_url / model，会覆盖上面的预设
# LLM_API_KEY=sk-你的key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#   DeepSeek 手动示例：
#   LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
#   通义千问手动示例：
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus

# 语音转写 ASR（把音频变成文字）
#   volc_asr：火山引擎「豆包语音」录音文件识别极速版（同步返回，带毫秒时间戳+说话人）
#   whisper_api：调 OpenAI Whisper（默认，按分钟计费，质量好）
#   local_whisper：本机跑 Whisper（免费但吃算力，建议有 GPU）
#   demo：规则生成占位
#
# --- 火山 ASR（与上面的 doubao 大模型配套，一家搞定）---
# ASR_PROVIDER=volc_asr
# VOLC_ASR_API_KEY=你的火山语音key
#   ⚠️ 这个 key 和方舟大模型的 key 不是同一个！
#   获取：https://console.volcengine.com/speech/new/setting/apikeys
#   （豆包语音控制台 → API Key 管理，需先开通语音识别服务）
#   ⚠️ 重要限制：火山 ASR 要求音频是「公网可访问」的链接，
#      所以「上传本地音频」的文件无法用它转写（localhost 火山服务器读不到）。
#      小宇宙链接导入的节目 → 用 volc_asr（快、准）
#      本地上传的音频     → 用 local_whisper（免费，慢）
#
# --- Whisper（备选）---
# ASR_PROVIDER=whisper_api
# WHISPER_API_KEY=sk-你的key（可与 LLM 同一家时复用 LLM_API_KEY）
# WHISPER_MODEL=whisper-1

# 本地音频上传（前端「上传本地音频」按钮）
# MAX_UPLOAD_MB=200        # 单文件上限（MB）
# 上传文件存于 data/uploads/，audio_url 记为 /uploads/xxx 供前端播放

# 服务端口（默认 8000，浏览器访问 http://localhost:8000 ）
# PORT=8000
